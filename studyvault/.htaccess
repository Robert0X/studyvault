# StudyVault — configuración Apache/PHP local
# Permite subir archivos grandes (libros en PDF) desde la app.
# Si PHP corre como módulo de Apache (caso XAMPP por defecto), estos valores
# sobreescriben a php.ini sin necesidad de reiniciar el servidor.

<IfModule mod_php.c>
    php_value upload_max_filesize 50M
    php_value post_max_size       60M
    php_value memory_limit        128M
    php_value max_execution_time  120
    php_value max_input_time      120
</IfModule>

<IfModule mod_php7.c>
    php_value upload_max_filesize 50M
    php_value post_max_size       60M
    php_value memory_limit        128M
    php_value max_execution_time  120
    php_value max_input_time      120
</IfModule>

<IfModule mod_php8.c>
    php_value upload_max_filesize 50M
    php_value post_max_size       60M
    php_value memory_limit        128M
    php_value max_execution_time  120
    php_value max_input_time      120
</IfModule>
